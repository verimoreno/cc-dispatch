#!/usr/bin/env bash
# cc-spawn — spawn a Claude Code session in a Docker container with auto-created worktree
# Registers the session with agent-deck so it appears in `agent-deck list` and the TUI.
# Usage: cc-spawn <repo-name-or-url> <branch-name>

set -euo pipefail

DETACH=0
if [[ "${1:-}" == "--detach" ]]; then DETACH=1; shift; fi

REPO_INPUT="${1:-}"
BRANCH="${2:-}"

if [[ -z "$REPO_INPUT" || -z "$BRANCH" ]]; then
  cat <<EOF
Usage: cc-spawn [--detach] <repo-name-or-url> <branch-name>

  --detach   create worktree+container, register, mark running, and EXIT
             without attaching — for orchestrators (pair with cc-launch).
             No tmux holding-window dance needed: run it directly over ssh.

Examples:
  cc-spawn cleanup feature-laundry-v2
  cc-spawn fractional bugfix-roadmap
  cc-spawn git@github.com:wearefractional/cleanup.git hotfix-auth

Default org: wearefractional. Override by passing full git URL.
EOF
  exit 1
fi

BASE_DIR="${CC_BASE_DIR:-$HOME/Fractional}"
DEFAULT_ORG="${CC_DEFAULT_ORG:-wearefractional}"
AGENTDECK_GROUP="${CC_AGENTDECK_GROUP:-work}"

if [[ "$REPO_INPUT" =~ ^(https?://|git@) ]]; then
  REPO_URL="$REPO_INPUT"
  REPO_NAME=$(basename "$REPO_INPUT" .git)
else
  REPO_NAME="$REPO_INPUT"
  REPO_URL="git@github.com:${DEFAULT_ORG}/${REPO_NAME}.git"
fi

REPO_DIR="$BASE_DIR/$REPO_NAME"
BARE_DIR="$REPO_DIR/.bare"
WORKTREE_DIR="$REPO_DIR/wt-$BRANCH"

SESSION_NAME="${REPO_NAME}-${BRANCH}"
SESSION_NAME=$(echo "$SESSION_NAME" | tr '/' '-' | tr -cd 'a-zA-Z0-9-_' | tr 'A-Z' 'a-z')

echo "→ Repo:     $REPO_NAME ($REPO_URL)"
echo "→ Branch:   $BRANCH"
echo "→ Worktree: $WORKTREE_DIR"
echo "→ Session:  $SESSION_NAME"
echo

# 0. Admission + durable reservation via cc-ledger (Wave 2). The ledger is the single
# admission point for every spawn path: it checks the fleet/memory/start budgets and
# takes the repo@ref reservation in ONE locked transaction, so concurrent orchestrators
# cannot double-spawn or over-commit. Refusals print the reason and exit 2.
# Session tokens: CC_TOKENS=vercel,railway,supabase,gcp opt-in.
CC_MEM_LIMIT="${CC_MEM_LIMIT:-4g}"
case "$CC_MEM_LIMIT" in
  [2-8]g) REQ_GB="${CC_MEM_LIMIT%g}" ;;
  *) echo "ERROR: CC_MEM_LIMIT must be 2g..8g (got '$CC_MEM_LIMIT')" >&2; exit 1 ;;
esac
export CC_MEM_LIMIT
CC_TOKENS="${CC_TOKENS:-}"

CANON_REPO=$(echo "$REPO_URL" | sed -E 's#^(git@[^:]+:|https?://[^/]+/)##; s#\.git$##' | tr 'A-Z' 'a-z')
ATTEMPT_ID=""
STAGE=prepare
if ! docker ps --format '{{.Names}}' | grep -qx "$SESSION_NAME"; then
  ATTEMPT_ID=$(cc-ledger admit --session "$SESSION_NAME" --repo "$CANON_REPO" --ref "$BRANCH" \
    --mem "$REQ_GB" --requester "${CC_REQUESTER:-cc-spawn}") || exit $?
  trap '[[ -n "$ATTEMPT_ID" ]] && cc-ledger set "$ATTEMPT_ID" failed --stage "$STAGE" --msg "cc-spawn exited during $STAGE" >/dev/null 2>&1 || true' EXIT
  echo "[0/5] Admission OK — reservation $ATTEMPT_ID ($CANON_REPO@$BRANCH, ${REQ_GB}g)"
fi

# Optional per-repo short-lived GitHub token (CC_SCOPED_TOKEN=1; needs the GitHub App,
# see docs/scoped-github-tokens.md). ~1h TTL — good for short tasks; long sessions doing
# late `gh` calls should stay on the default token. git push is unaffected (SSH key).
if [[ "${CC_SCOPED_TOKEN:-0}" == "1" ]]; then
  if SCOPED=$(cc-github-token "$CANON_REPO"); then
    export GITHUB_TOKEN="$SCOPED"
    echo "      scoped GitHub token minted for $CANON_REPO (~1h TTL)"
  else
    echo "ERROR: CC_SCOPED_TOKEN=1 but token mint failed — refusing to fall back silently" >&2
    exit 1
  fi
fi

# Per-repo lock: two admitted spawns of DIFFERENT branches of one repo must not
# race the bare clone/fetch/worktree-add (max-starts=2 makes that reachable).
mkdir -p "$REPO_DIR"
exec 8>"$REPO_DIR/.spawn.lock"
flock -w 300 8 || { echo "ERROR: timed out waiting for per-repo spawn lock" >&2; exit 1; }

# 1. Clone bare repo if missing
STAGE=clone
if [[ ! -d "$BARE_DIR" ]]; then
  echo "[1/5] Bare repo missing — cloning $REPO_URL"
  mkdir -p "$REPO_DIR"
  git clone --bare "$REPO_URL" "$BARE_DIR"
  echo "gitdir: ./.bare" > "$REPO_DIR/.git"
  git --git-dir="$BARE_DIR" config remote.origin.fetch \
    "+refs/heads/*:refs/remotes/origin/*"
  git --git-dir="$BARE_DIR" fetch origin
else
  echo "[1/5] Bare repo exists — fetching latest"
  git --git-dir="$BARE_DIR" fetch origin --prune
fi

# 2. Create worktree if missing
STAGE=worktree
if [[ -d "$WORKTREE_DIR" ]]; then
  echo "[2/5] Worktree exists — reusing $WORKTREE_DIR"
else
  echo "[2/5] Creating worktree on branch '$BRANCH'"
  cd "$REPO_DIR"

  if git --git-dir="$BARE_DIR" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git --git-dir="$BARE_DIR" worktree add "$WORKTREE_DIR" "$BRANCH"
  elif git --git-dir="$BARE_DIR" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    git --git-dir="$BARE_DIR" worktree add "$WORKTREE_DIR" \
      -b "$BRANCH" --track "origin/$BRANCH"
  else
    DEFAULT_BRANCH="main"
    git --git-dir="$BARE_DIR" show-ref --verify --quiet "refs/remotes/origin/main" \
      || DEFAULT_BRANCH="master"
    echo "      → new branch, creating from origin/$DEFAULT_BRANCH"
    git --git-dir="$BARE_DIR" worktree add "$WORKTREE_DIR" \
      -b "$BRANCH" "origin/$DEFAULT_BRANCH"
  fi
fi

exec 8>&-   # release the per-repo lock: container/registration steps can overlap

# 3. Start container if not already running
STARTED_NOW=0
if docker ps --format '{{.Names}}' | grep -qx "$SESSION_NAME"; then
  echo "[3/5] Container '$SESSION_NAME' already running"
else
  echo "[3/5] Starting container"
  cd /opt/cc-sessions
  export SESSION_NAME
  export WORKTREE_PATH="$WORKTREE_DIR"
  export REPO_DIR
  COMPOSE_FILES=(-f docker-compose.yml)
  GRANTED=""
  for t in ${CC_TOKENS//,/ }; do
    case "$t" in
      vercel|railway|supabase|gcp) COMPOSE_FILES+=(-f "tokens.d/$t.yml"); GRANTED="$GRANTED $t" ;;
      "") ;;
      *) echo "ERROR: unknown token class '$t' (allowed: vercel,railway,supabase,gcp)" >&2; exit 1 ;;
    esac
  done
  [[ -n "$GRANTED" ]] && echo "      tokens granted:$GRANTED"
  STAGE=container
  docker compose "${COMPOSE_FILES[@]}" -p "$SESSION_NAME" up -d
  STARTED_NOW=1
  if [[ -n "$ATTEMPT_ID" ]]; then
    CID=$(docker inspect --format '{{.Id}}' "$SESSION_NAME" 2>/dev/null || true)
    cc-ledger set "$ATTEMPT_ID" starting ${CID:+--container "$CID"} >/dev/null || true
  fi
  STAGE=register
  sleep 1
fi

# 4. Register with agent-deck (idempotent)
existing_id=$(agent-deck list -json 2>/dev/null | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    sessions = data if isinstance(data, list) else data.get('sessions', [])
    for s in sessions:
        if s.get('title') == '$SESSION_NAME':
            print(s.get('id', ''))
            break
except Exception:
    pass
" 2>/dev/null || true)

if [[ -n "$existing_id" ]]; then
  echo "[4/5] agent-deck instance exists (id=$existing_id) — reusing"
  AGENTDECK_ID="$existing_id"
else
  echo "[4/5] Registering with agent-deck (group=$AGENTDECK_GROUP)"
  AGENTDECK_ID=$(agent-deck add "$WORKTREE_DIR" \
    -t="$SESSION_NAME" \
    -g="$AGENTDECK_GROUP" \
    --no-parent \
    -cmd="docker exec -it $SESSION_NAME bash" \
    -json 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin).get('id',''))" 2>/dev/null || true)

  if [[ -z "$AGENTDECK_ID" ]]; then
    echo "      WARN: agent-deck add failed — falling back to plain tmux"
    AGENTDECK_ID=""
  fi
fi

# 5. Start agent-deck session (creates tmux) and attach
if [[ -n "$AGENTDECK_ID" ]]; then
  if [[ "$DETACH" == "1" ]]; then echo "[5/5] Finalizing (detached)"; else
    echo "[5/5] Attaching via agent-deck (Ctrl-B D to detach, container keeps running)"
  fi
  agent-deck session start "$AGENTDECK_ID" 2>&1 | grep -v '^$' || true
  # Disable tmux mouse so terminal-native copy works (agent-deck force-enables mouse per session)
  tmux_name=$(agent-deck list -json 2>/dev/null | python3 -c "
import json, sys
target='$AGENTDECK_ID'
for s in json.load(sys.stdin):
    if s.get('id') == target:
        print(s.get('tmux_session', ''))
        break
" 2>/dev/null || true)
  if [[ -n "$tmux_name" ]]; then
    tmux set-option -t "$tmux_name" mouse off 2>/dev/null || true
  fi
  if [[ -n "$ATTEMPT_ID" ]]; then
    cc-ledger set "$ATTEMPT_ID" running ${tmux_name:+--tmux "$tmux_name"} >/dev/null || true
    trap - EXIT
  fi
  if [[ "$DETACH" == "1" ]]; then
    echo "[5/5] Detached — session $SESSION_NAME ready (tmux: ${tmux_name:-unknown})"
    exit 0
  fi
  exec agent-deck session attach "$AGENTDECK_ID"
fi

# Fallback path — agent-deck unavailable: legacy tmux behavior
if [[ -n "$ATTEMPT_ID" ]]; then
  cc-ledger set "$ATTEMPT_ID" running --tmux "$SESSION_NAME" >/dev/null || true
  trap - EXIT
fi
if [[ "$DETACH" == "1" ]]; then
  tmux has-session -t "$SESSION_NAME" 2>/dev/null || \
    tmux new-session -d -s "$SESSION_NAME" "docker exec -it $SESSION_NAME bash"
  echo "[5/5] Detached — fallback tmux session $SESSION_NAME (agent-deck unavailable)"
  exit 0
fi
echo "[5/5] Attaching via tmux (fallback — agent-deck unavailable)"
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  exec tmux attach-session -t "$SESSION_NAME"
fi
exec tmux new-session -s "$SESSION_NAME" \
  "docker exec -it $SESSION_NAME bash; echo; echo '[Container shell exited. Press Enter to close.]'; read"
