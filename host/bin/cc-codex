#!/usr/bin/env bash
# cc-codex — spawn an OpenAI Codex session in a Docker container with an auto-created worktree.
# Mirrors cc-code, but launches Codex (cxd = codex --dangerously-bypass-approvals-and-sandbox)
# instead of OpenCode. Codex auth comes from the shared cc-codex volume — log in ONCE with
# `codex login --device-auth` in any session and every cc-codex session inherits it.
# Models are OpenAI's (via your ChatGPT login) — no go:/openrouter/deepseek lanes.
# Registers with agent-deck (group=codex). Usage: cc-codex <repo-name-or-url> <branch-name>

set -euo pipefail

REPO_INPUT="${1:-}"
BRANCH="${2:-}"

if [[ -z "$REPO_INPUT" || -z "$BRANCH" ]]; then
  cat <<EOF
Usage: cc-codex <repo-name-or-url> <branch-name>

Launches OpenAI Codex in autonomous mode (codex --dangerously-bypass-approvals-and-sandbox).
Auth: your ChatGPT login from the shared cc-codex volume — log in once with
  codex login --device-auth
Session, worktree and agent-deck group are suffixed '-codex'.

Examples:
  cc-codex cleanup-laundry dev-branch-codex   # -> session cleanup-laundry-dev-branch-codex
  cc-codex fractional my-feature

Default org: wearefractional. Override by passing full git URL.
EOF
  exit 1
fi

# ---- Codex fleet config ----
SUFFIX="codex"
AGENTDECK_GROUP="${CC_AGENTDECK_GROUP:-codex}"
LABEL="Codex (autonomous / cxd)"

BASE_DIR="${CC_BASE_DIR:-$HOME/Fractional}"
DEFAULT_ORG="${CC_DEFAULT_ORG:-wearefractional}"

if [[ "$REPO_INPUT" =~ ^(https?://|git@) ]]; then
  REPO_URL="$REPO_INPUT"
  REPO_NAME=$(basename "$REPO_INPUT" .git)
else
  REPO_NAME="$REPO_INPUT"
  REPO_URL="git@github.com:${DEFAULT_ORG}/${REPO_NAME}.git"
fi

REPO_DIR="$BASE_DIR/$REPO_NAME"
BARE_DIR="$REPO_DIR/.bare"
WORKTREE_DIR="$REPO_DIR/wt-${BRANCH}-${SUFFIX}"

SESSION_NAME="${REPO_NAME}-${BRANCH}-${SUFFIX}"
SESSION_NAME=$(echo "$SESSION_NAME" | tr '/' '-' | tr -cd 'a-zA-Z0-9-_' | tr 'A-Z' 'a-z')

echo "→ Repo:     $REPO_NAME ($REPO_URL)"
echo "→ Branch:   $BRANCH"
echo "→ Worktree: $WORKTREE_DIR"
echo "→ Session:  $SESSION_NAME"
echo "→ Agent:    $LABEL"
echo

# 1. Clone bare repo if missing
if [[ ! -d "$BARE_DIR" ]]; then
  echo "[1/5] Bare repo missing — cloning $REPO_URL"
  mkdir -p "$REPO_DIR"
  git clone --bare "$REPO_URL" "$BARE_DIR"
  echo "gitdir: ./.bare" > "$REPO_DIR/.git"
  git --git-dir="$BARE_DIR" config remote.origin.fetch \
    "+refs/heads/*:refs/remotes/origin/*"
  git --git-dir="$BARE_DIR" fetch origin
else
  echo "[1/5] Bare repo exists — fetching latest"
  git --git-dir="$BARE_DIR" fetch origin --prune
fi

# 2. Create worktree if missing
if [[ -d "$WORKTREE_DIR" ]]; then
  echo "[2/5] Worktree exists — reusing $WORKTREE_DIR"
else
  echo "[2/5] Creating worktree on branch '$BRANCH'"
  cd "$REPO_DIR"

  if git --git-dir="$BARE_DIR" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git --git-dir="$BARE_DIR" worktree add "$WORKTREE_DIR" "$BRANCH"
  elif git --git-dir="$BARE_DIR" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    git --git-dir="$BARE_DIR" worktree add "$WORKTREE_DIR" \
      -b "$BRANCH" --track "origin/$BRANCH"
  else
    DEFAULT_BRANCH="main"
    git --git-dir="$BARE_DIR" show-ref --verify --quiet "refs/remotes/origin/main" \
      || DEFAULT_BRANCH="master"
    echo "      → new branch, creating from origin/$DEFAULT_BRANCH"
    git --git-dir="$BARE_DIR" worktree add "$WORKTREE_DIR" \
      -b "$BRANCH" "origin/$DEFAULT_BRANCH"
  fi
fi

# 3. Start container if not already running
STARTED_NOW=0   # 1 only on a fresh container start -> gates the cxd auto-launch below
if docker ps --format '{{.Names}}' | grep -qx "$SESSION_NAME"; then
  echo "[3/5] Container '$SESSION_NAME' already running"
else
  echo "[3/5] Starting container"
  cd /opt/cc-sessions
  export SESSION_NAME
  export WORKTREE_PATH="$WORKTREE_DIR"
  export REPO_DIR
  docker compose -p "$SESSION_NAME" up -d
  STARTED_NOW=1
  sleep 1
fi

# 3b. Auto-build the graphify knowledge graph in the background (fresh start only) so the agent can
#     query it (graphify query/explain/path) instead of reading files. Best-effort; git-excluded.
if [[ "${STARTED_NOW:-0}" == "1" ]]; then
  docker exec -d "$SESSION_NAME" bash -lc '
    cd /home/pwuser/work 2>/dev/null || exit 0
    command -v graphify >/dev/null 2>&1 || exit 0
    ex=$(git rev-parse --git-path info/exclude 2>/dev/null) && [ -n "$ex" ] && ! grep -qxF "graphify-out/" "$ex" 2>/dev/null && printf "graphify-out/\n" >> "$ex"
    graphify . --no-viz >/tmp/graphify-build.log 2>&1
  ' >/dev/null 2>&1 || true
  echo "[3b] graphify knowledge graph building in background"
fi

# 4. Register with agent-deck (idempotent)
existing_id=$(agent-deck list -json 2>/dev/null | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    sessions = data if isinstance(data, list) else data.get('sessions', [])
    for s in sessions:
        if s.get('title') == '$SESSION_NAME':
            print(s.get('id', ''))
            break
except Exception:
    pass
" 2>/dev/null || true)

if [[ -n "$existing_id" ]]; then
  echo "[4/5] agent-deck instance exists (id=$existing_id) — reusing"
  AGENTDECK_ID="$existing_id"
else
  echo "[4/5] Registering with agent-deck (group=$AGENTDECK_GROUP)"
  AGENTDECK_ID=$(agent-deck add "$WORKTREE_DIR" \
    -t="$SESSION_NAME" \
    -g="$AGENTDECK_GROUP" \
    --no-parent \
    -cmd="docker exec -it $SESSION_NAME bash" \
    -json 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin).get('id',''))" 2>/dev/null || true)

  if [[ -z "$AGENTDECK_ID" ]]; then
    echo "      WARN: agent-deck add failed — falling back to plain tmux"
    AGENTDECK_ID=""
  fi
fi

# 5. Start agent-deck session (creates tmux) and attach
if [[ -n "$AGENTDECK_ID" ]]; then
  echo "[5/5] Attaching via agent-deck (Ctrl-B D to detach, container keeps running)"
  agent-deck session start "$AGENTDECK_ID" 2>&1 | grep -v '^$' || true
  # Disable tmux mouse so terminal-native copy works (agent-deck force-enables mouse per session)
  tmux_name=$(agent-deck list -json 2>/dev/null | python3 -c "
import json, sys
target='$AGENTDECK_ID'
for s in json.load(sys.stdin):
    if s.get('id') == target:
        print(s.get('tmux_session', ''))
        break
" 2>/dev/null || true)
  if [[ -n "$tmux_name" ]]; then
    tmux set-option -t "$tmux_name" mouse off 2>/dev/null || true
    if [[ "$STARTED_NOW" == "1" ]]; then
      # Auto-launch Codex via cxd on first spawn (if logged in); else print the login hint and
      # drop to a shell. Gated on fresh start so a reattach doesn't type into a running Codex.
      tmux send-keys -t "$tmux_name" "clear; if codex login status >/dev/null 2>&1; then echo 'Launching Codex (cxd)...'; cxd; else echo 'Codex not logged in. Run:  codex login --device-auth   then:  cxd'; fi" Enter 2>/dev/null || true
    fi
  fi
  exec agent-deck session attach "$AGENTDECK_ID"
fi

# Fallback path — agent-deck unavailable: legacy tmux behavior
echo "[5/5] Attaching via tmux (fallback — agent-deck unavailable)"
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  exec tmux attach-session -t "$SESSION_NAME"
fi
exec tmux new-session -s "$SESSION_NAME" \
  "docker exec -it $SESSION_NAME bash; echo; echo '[Container shell exited. Press Enter to close.]'; read"
