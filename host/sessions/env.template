# ---- CC_TOKENS=gcp (tokens.d/gcp.yml) — foraudits staging on GCP -------------
# Names only. Values live in /opt/cc-sessions/.env (0600, unmanaged, never in git).
# GOOGLE_APPLICATION_CREDENTIALS_JSON: the service-account key as a SINGLE LINE of
#   JSON, wrapped in SINGLE quotes. Double quotes fail loudly: the JSON's own "
#   terminates the value early and compose then refuses to read the whole file.
#   Produce the value with:  jq -c . sa.json
#   Never store a key that has not passed the mint gate in host/README.md.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GCP_PROJECT=
GOOGLE_CLOUD_PROJECT=
GIP_API_KEY=
CLOUD_SQL_INSTANCE=
DATABASE_URL_SESSION=
DATABASE_URL_TX_POOLER=
SEED_TENANT_DB_USER=
SEED_TENANT_DB_TOKEN=
# GIP_ADMIN_ACCESS_TOKEN is intentionally NOT here — ~1h TTL, minted per session.
