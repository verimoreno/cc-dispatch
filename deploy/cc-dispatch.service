[Unit]
Description=cc-dispatch session manager
# Tailscale must be up first: the service binds to the host's Tailscale IP.
After=network-online.target tailscaled.service
Wants=network-online.target
# Never cap restarts: this is an always-on service that must recover on its own,
# including retrying through the brief window before tailscaled assigns its IP.
StartLimitIntervalSec=0

[Service]
# __USER__ / __DIR__ are filled in by deploy/install-on-host.sh
User=__USER__
WorkingDirectory=__DIR__
# Wait (up to ~2 min) for the Tailscale IPv4 to actually be assigned before we
# start, so uvicorn's bind() to it can't fail with EADDRNOTAVAIL on a cold boot.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 120); do [ -n "$(tailscale ip -4 2>/dev/null)" ] && exit 0; sleep 1; done; exit 1'
ExecStart=__DIR__/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
