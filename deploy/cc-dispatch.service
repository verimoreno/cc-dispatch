[Unit]
Description=cc-dispatch session manager
# Tailscale must be up first: the service binds to the host's Tailscale IP.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
# __USER__ / __DIR__ are filled in by deploy/install-on-host.sh
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
